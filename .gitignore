**/*.jar
**/*.war
**/*.ear

# НО: если ты хочешь коммитить готовый jar (например релиз плагина),
# тогда удали строки выше и добавь исключение для конкретного файла:
# !minecraft-plugin-folia/TaskForgeFoliaPlugin/build/libs/*.jar
.directory

