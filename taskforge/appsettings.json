{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=taskforge_dev;Username=postgres;Password=SuperSecret"
  },
  "Compilers": {
    "cpp":    { "Url": "http://cpp-runner:8080/run",    "TimeoutMs": 12000 },
    "csharp": { "Url": "http://csharp-runner:8080/run", "TimeoutMs": 12000 },
    "python": { "Url": "http://python-runner:8080/run", "TimeoutMs": 8000  },
    "javascript": { "Url": "http://javascript-runner:8080/run", "TimeoutMs": 8000 },
    "pascal": { "Url": "http://pascal-runner:8080/run", "TimeoutMs": 8000 },
    "java":   { "Url": "http://java-runner:8080/run",   "TimeoutMs": 12000 }
  },

  "ImageRunners": {
    "PythonUrl": "http://image-python-runner:8000",
    "PascalUrl": "http://image-pascal-runner:8000",
    "TimeoutMs": 15000
  },

  "ImageTests": {
    "VerboseConsole": true,
    "DumpIntermediate": false,
    "DumpDir": "/tmp/image-tests"
  },

  "Jwt": {
    "Key": "CHANGE_ME_IN_ENV",
    "Issuer": "TaskForgeApi",
    "Audience": "TaskForgeApiClient",
    "ExpireMinutes": 120
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "Bucket": "taskforge",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Region": "us-east-1",
    "UsePathStyle": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runners": {
    "GppPath": "C:/msys64/ucrt64/bin/g++.exe",
    "RunTimeoutMs": 5000,
    "CompileTimeoutMs": 10000
  }

}
