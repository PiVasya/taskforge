<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
  <!-- Оставляем доступную версию FuzzySharp -->
  <PackageReference Include="FuzzySharp" Version="2.0.2" />

  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
  <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />

  <!-- Выравниваем провайдер и инструменты EF Core на 9.0.1 -->
  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.1" />
  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
    <PrivateAssets>all</PrivateAssets>
    <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
  </PackageReference>

  <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

  <!-- S3 compatible storage (MinIO) for editor images and other media -->
  <PackageReference Include="AWSSDK.S3" Version="3.7.403.2" />

  <!-- Image compare for image-test -->
  <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />

  <!-- Image alignment + feature matching (ORB) for image-test -->
  <!--
    IMPORTANT:
    OpenCvSharp needs BOTH:
      1) Managed wrapper package: OpenCvSharp4
      2) Native runtime package: Sdcb.OpenCvSharp4.mini.runtime.*

    The runtime package must match the container OS. The API container uses Debian 12 (bookworm),
    so we MUST use the Debian 12 native runtime package.

    Why we pin to 4.8.x:
    The Debian 12 mini-runtime package is currently published on NuGet only for OpenCV 4.8.x,
    so requesting 4.11.* leads to restore/build instability and/or runtime loader issues.
  -->
  <PackageReference Include="OpenCvSharp4" Version="4.8.0.20230708" />

  <!--
    IMPORTANT:
    We MUST ship a native runtime that includes the OpenCV "features2d" module.
    The "mini" runtimes intentionally exclude some modules and caused runtime crash:
      EntryPointNotFoundException: features2d_ORB_create

    Use the full Debian 12 runtime instead.
  -->
  <PackageReference Include="Sdcb.OpenCvSharp4.runtime.debian.12-x64" Version="4.8.0.20231125" />

</ItemGroup>



</Project>
