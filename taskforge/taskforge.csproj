<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
  <!-- Оставляем доступную версию FuzzySharp -->
  <PackageReference Include="FuzzySharp" Version="2.0.2" />

  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
  <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />

  <!-- Выравниваем провайдер и инструменты EF Core на 9.0.1 -->
  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.1" />
  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
    <PrivateAssets>all</PrivateAssets>
    <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
  </PackageReference>

  <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

  <!-- S3 compatible storage (MinIO) for editor images and other media -->
  <PackageReference Include="AWSSDK.S3" Version="3.7.403.2" />

  <!-- Image compare for image-test -->
  <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />

  <!-- Image alignment + feature matching (ORB) for image-test -->
  <!--
    IMPORTANT:
    OpenCvSharp needs BOTH:
      1) Managed wrapper package: OpenCvSharp4
      2) Native runtime package (libOpenCvSharpExtern.so) compatible with Linux

    We use the official Linux runtime package and keep versions aligned.
    (The Sdcb "mini" runtime does NOT include the features2d module, so ORB would fail.)
  -->
  <!-- OpenCV (used by ImageTests: decoding, diffing, ORB align, etc.) -->
  <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />

  <!--
    Runtime native binaries for Linux.
    This is the standard/most common way people deploy OpenCvSharp in Linux containers:
    keep managed + runtime package versions aligned.
  -->
  <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.11.0.20250507" />

</ItemGroup>



</Project>
