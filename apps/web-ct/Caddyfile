:80 {
	respond /health "ok" 200

	root * /usr/share/caddy
	encode zstd gzip
	try_files {path} /index.html

	@assets {
		path_regexp static ^/static/.+\.(css|js|mjs|png|jpg|jpeg|svg|webp|ico|woff2?)$
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	@non_indexable_routes {
		not path /privacy /static/* /favicon* /manifest.json /asset-manifest.json /health
	}
	header @non_indexable_routes X-Robots-Tag "noindex, nofollow"

	file_server
}
