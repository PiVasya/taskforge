<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Compile Include="$(MSBuildThisFileDirectory)services/shared/TaskForgeCache.cs" Link="Shared/TaskForgeCache.cs" Condition="Exists('$(MSBuildThisFileDirectory)services/shared/TaskForgeCache.cs')" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8" />
  </ItemGroup>
</Project>
