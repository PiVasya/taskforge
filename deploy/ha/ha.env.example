# A
HA_ENABLED=true
HA_NODE_ID=A
HA_PREFERRED_NODE=A
HA_WG_CIDR=10.80.0.0/24
HA_WG_IP=10.80.0.1
HA_PEER_WG_IP=10.80.0.2
HA_NODE_A_PUBLIC_IP=A_PUBLIC_IP
HA_NODE_B_PUBLIC_IP=B_PUBLIC_IP
HA_AGENT_PORT=9187
HA_AUTO_FAILOVER=true
HA_AUTO_FAILBACK=true
HA_FAILOVER_AFTER_SECONDS=30
HA_SERVICE_FAILOVER_AFTER_SECONDS=90
HA_FAILBACK_DELAY_SECONDS=180
HA_FAILBACK_STABLE_SECONDS=30
HA_FAILBACK_MAX_LAG_BYTES=1048576
HA_REJOIN_AFTER_SECONDS=120
HA_MINIO_DRAIN_TIMEOUT_SECONDS=300
POSTGRES_RESTART_POLICY=no
POSTGRES_BIND=10.80.0.1
MINIO_BIND=10.80.0.1
HA_FENCE_SCRIPT=/absolute/path/to/fence-provider.sh
HA_RECOVER_SCRIPT=/absolute/path/to/recover-provider.sh
HA_ALLOW_UNFENCED_FAILOVER=false

