# Compose/project
COMPOSE_PROJECT_NAME=taskforge-prod
IMAGE_REPOSITORY=ghcr.io/CHANGE_ME_OWNER/CHANGE_ME_REPO
IMAGE_TAG=develop
ASPNETCORE_ENVIRONMENT=Production
MIGRATE_ON_STARTUP=true
ENSURE_CREATED=false

# Public gateway
DOMAIN=taskforge.example.com
CT_DOMAIN=ct.taskforge.example.com
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# http = immediate production start behind Cloudflare/external TLS proxy.
# auto = bootstrap/https depending on cert presence.
# https = force HTTPS config after certbot issued certificates.
GATEWAY_MODE=http
LETSENCRYPT_EMAIL=admin@example.com

# Internal infra ports are bound to localhost by default.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
RABBITMQ_BIND=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_BIND=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Secrets. Replace all values before production.
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
RABBITMQ_DEFAULT_USER=taskforge
RABBITMQ_DEFAULT_PASS=CHANGE_ME_LONG_RANDOM_RABBITMQ_PASSWORD
MINIO_ROOT_USER=taskforge
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_64_RANDOM_CHARS_FOR_JWT_SIGNING_KEY_1234567890
JWT_ISSUER=TaskForge
JWT_AUDIENCE=TaskForge
JWT_EXPIRE_MINUTES=120

# S3/MinIO endpoints.
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.taskforge.example.com

# Service database endpoint.
# For first single-host production leave DB_HOST=postgres.
# For external/replicated DB change DB_HOST/DB_PORT here; database names stay per service.
DB_HOST=postgres
DB_PORT=5432

# External integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPPORT_BOT_TOKEN=
TELEGRAM_TEACHER_BOT_TOKEN=
TELEGRAM_STUDENT_BOT_TOKEN=
TELEGRAM_TEACHER_PASSWORD=
TASKFORGE_INTERNAL_KEY=

# AI worker provider/internal API settings
TASKFORGE_AGENT_INTERNAL_KEY=
TASKFORGE_EXTERNAL_AI_API_KEY=
TASKFORGE_EXTERNAL_AI_MODEL=openai/gpt-4o-mini
