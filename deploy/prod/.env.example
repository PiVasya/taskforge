# Compose/project
COMPOSE_PROJECT_NAME=taskforge-prod
IMAGE_REPOSITORY=ghcr.io/CHANGE_ME_OWNER/CHANGE_ME_REPO
IMAGE_TAG=develop
ASPNETCORE_ENVIRONMENT=Production
MIGRATE_ON_STARTUP=true
ENSURE_CREATED=false
# Development/debug logging toggle. 1 = verbose logs, 0 = quieter production-style logs.
TASKFORGE_DEBUG_LOGS=1

# Public gateway
DOMAIN=taskforge.by
CT_DOMAIN=ct.taskforge.by
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# http = immediate production start behind Cloudflare/external TLS proxy.
# auto = bootstrap/https depending on cert presence.
# https = force HTTPS config after certbot issued certificates.
GATEWAY_MODE=auto

# HA role used by /ha/primary-ready. primary returns 200, standby returns 503.
TASKFORGE_NODE_ROLE=primary
LETSENCRYPT_EMAIL=CHANGE_ME_ADMIN_EMAIL
# Watchtower with modern Docker daemons should not negotiate legacy API 1.25.
DOCKER_API_VERSION=1.40

# Internal infra ports are bound to localhost by default.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
RABBITMQ_BIND=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_BIND=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# Secrets. Replace all values before production.
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_IMAGE=postgres:18-alpine
RABBITMQ_DEFAULT_USER=taskforge
RABBITMQ_DEFAULT_PASS=CHANGE_ME_LONG_RANDOM_RABBITMQ_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=taskforge
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
S3_BUCKET=taskforge-files
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_64_RANDOM_CHARS_FOR_JWT_SIGNING_KEY_1234567890
JWT_ISSUER=TaskForge
JWT_AUDIENCE=TaskForge
JWT_EXPIRE_MINUTES=120

# Admin bootstrap is explicit. Do not rely on hidden "first user is admin" behavior.
BOOTSTRAP_FIRST_USER_IS_ADMIN=false
BOOTSTRAP_ADMIN_EMAILS=CHANGE_ME_ADMIN_EMAIL

# S3/MinIO endpoints.
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.taskforge.by

# Redis/distributed cache. Keep enabled for production; lower TTLs if you need faster UI propagation.
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_METADATA_TTL_SECONDS=300
CACHE_USER_SUMMARIES_TTL_SECONDS=120
CACHE_LEADERBOARD_TTL_SECONDS=30
CACHE_ACTIVITY_TTL_SECONDS=30

# Service database endpoint.
# For first single-host production leave DB_HOST=postgres.
# For external/replicated DB change DB_HOST/DB_PORT here; database names stay per service.
DB_HOST=postgres
DB_PORT=5432

# Minecraft integration
MINECRAFT_WEBHOOK_BASE_URL=http://mc.taskforge.by:25566
MINECRAFT_WEBHOOK_SEND_CODE_PATH=/taskforge/link/send
MINECRAFT_WEBHOOK_KEY=
MINECRAFT_HEALTH_URL=http://mc.taskforge.by:25566/health
MINECRAFT_PLUGIN_KEY=
MINECRAFT_DEATH_COORDINATES_COST=10
MINECRAFT_DEATH_CHEST_COST=50
MINECRAFT_DEATH_TELEPORT_COST=100
MINECRAFT_DEATH_INVENTORY_COST=300

# External integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_GROUP_ID=
SUPPORT_BOT_USERNAME=@taskforgeby_bot
TELEGRAM_LINK_CODE_LIFETIME_MINUTES=10
TELEGRAM_LINK_CODE_COOLDOWN_SECONDS=30
TELEGRAM_LINK_CODE_ISSUE_LIMIT=5
TELEGRAM_LINK_CODE_ISSUE_WINDOW_MINUTES=60
TELEGRAM_LINK_CONFIRM_ATTEMPT_LIMIT=8
TELEGRAM_LINK_CONFIRM_ATTEMPT_WINDOW_MINUTES=5
TELEGRAM_TEACHER_BOT_TOKEN=
TELEGRAM_STUDENT_BOT_TOKEN=
TELEGRAM_TEACHER_PASSWORD=
TASKFORGE_INTERNAL_KEY=CHANGE_ME_INTERNAL_GATEWAY_KEY


# User energy / quotas. One task charge is restored every 90 seconds.
# Opening the rating page consumes one of five charges; one charge returns every 30 minutes.
TASKFORGE_TASK_ENERGY_CAPACITY=10
TASKFORGE_TASK_ENERGY_REFILL_SECONDS=90
TASKFORGE_RATING_ENERGY_CAPACITY=5
TASKFORGE_RATING_ENERGY_REFILL_SECONDS=1800
TASKFORGE_RATING_VIEW_SESSION_SECONDS=7200

# Language runner container limits. Increase only if real tasks need more resources.
RUNNER_CPUS=1.0
RUNNER_MEM_LIMIT=512m
RUNNER_PIDS_LIMIT=128
RUNNER_TMPFS_SIZE=256m

# AI worker provider/internal API settings
TASKFORGE_AGENT_INTERNAL_KEY=CHANGE_ME_AGENT_INTERNAL_KEY
TASKFORGE_EXTERNAL_AI_API_KEY=
TASKFORGE_EXTERNAL_AI_MODEL=openai/gpt-4o-mini
TASKFORGE_EXTERNAL_AI_BASE_URL=https://openrouter.ai/api/v1
TASKFORGE_AI_ADAPTIVE_LOOP=true
TASKFORGE_AI_MAX_LOOP_STEPS=12
TASKFORGE_AI_MAX_DRAFTS_PER_RUN=50
TASKFORGE_AI_MAX_STATE_CHARS=64000
TASKFORGE_AI_MAX_ACTIONS_PER_STEP=8
TASKFORGE_AI_MAX_PATCH_OPERATIONS=200
# Judge / execution queue
JUDGE_TIMEOUT_SECONDS=45
EXECUTION_QUEUE_MAX_ATTEMPTS=3
EXECUTION_QUEUE_RUNNING_TIMEOUT_MINUTES=5
CODE_ANALYZER_ENABLED=true
CODE_ANALYZER_FAIL_CLOSED=true
CODE_ANALYZER_TIMEOUT_SECONDS=8
CODE_ANALYZER_ATTESTATION_TTL_SECONDS=120
CODE_ANALYZER_MAX_PARALLEL=2
CODE_ANALYZER_CPUS=1.0
CODE_ANALYZER_MEM_LIMIT=512m
CODE_ANALYZER_PIDS_LIMIT=32
CODE_ANALYZER_TMPFS_SIZE=96m
# Absolute host paths. Generate once with:
# ./scripts/security/generate-code-analyzer-keypair.sh /srv/taskforge/secrets/code-analyzer
CODE_ANALYZER_PRIVATE_KEY_PATH=/srv/taskforge/secrets/code-analyzer/code-analyzer-private.pem
CODE_ANALYZER_PUBLIC_KEY_PATH=/srv/taskforge/secrets/code-analyzer/code-analyzer-public.pem


# Watchtower pulls updated GHCR images on the server. Only services with watchtower labels are updated.
WATCHTOWER_SCOPE=taskforge-prod
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_OJ_ENABLE=false
WATCHTOWER_CLEANUP=true
WATCHTOWER_INCLUDE_RESTARTING=true
WATCHTOWER_ROLLING_RESTART=true
WATCHTOWER_NO_STARTUP_MESSAGE=true
WATCHTOWER_HTTP_API_UPDATE=false

# Upload limits
FILES_MAX_UPLOAD_BYTES=10485760
IMAGE_ANALYZER_MEM_LIMIT=6g
IMAGE_ANALYZER_MEMSWAP_LIMIT=8g
IMAGE_ANALYZER_PIDS_LIMIT=128
IMAGE_ANALYZER_TMPFS_SIZE=1g

# Rating projection worker
RATING_DIRTY_INTERVAL_MINUTES=10
RATING_FULL_REBUILD_INTERVAL_HOURS=24
RATING_DIRTY_BATCH_SIZE=500

# Observability / admin analytics
ANALYTICS_COLLECT_IP_METADATA=true
# Stable secret salt for anonymized IP hashing. Do not publish it.
ANALYTICS_IP_HASH_SALT=change_me_to_random_32_plus_chars

# Public Chromium Browser API for AI agents and UI audits.
# Only TaskForge origins are accepted; this is not an arbitrary URL renderer.
BROWSER_MAIN_ORIGIN=https://taskforge.by
BROWSER_CT_ORIGIN=https://ct.taskforge.by
BROWSER_ALLOWED_EXTERNAL_ORIGINS=https://s3.taskforge.by
BROWSER_DISABLE_SANDBOX=true
BROWSER_IGNORE_HTTPS_ERRORS=false
BROWSER_NAVIGATION_TIMEOUT_SECONDS=20
BROWSER_ACTION_TIMEOUT_SECONDS=10
BROWSER_DEFAULT_WAIT_MILLISECONDS=800
BROWSER_MAX_WAIT_MILLISECONDS=5000
BROWSER_MIN_VIEWPORT_WIDTH=320
BROWSER_MAX_VIEWPORT_WIDTH=2560
BROWSER_MIN_VIEWPORT_HEIGHT=320
BROWSER_MAX_VIEWPORT_HEIGHT=1440
BROWSER_MAX_FULL_PAGE_HEIGHT=20000
BROWSER_MAX_SCREENSHOT_PIXELS=24000000
BROWSER_MAX_SNAPSHOT_ELEMENTS=500
BROWSER_MAX_SNAPSHOT_TEXT_CHARACTERS=64000
BROWSER_MAX_ARIA_SNAPSHOT_CHARACTERS=64000
BROWSER_ARIA_SNAPSHOT_DEPTH=14
BROWSER_MAX_EVENT_ENTRIES=160
BROWSER_MAX_CACHED_ARTIFACT_BYTES=4194304
BROWSER_MAX_ARTIFACT_RESPONSE_BYTES=33554432
BROWSER_REDUCE_MOTION=true
BROWSER_RATE_LIMITS_ENABLED=true
BROWSER_METADATA_LIMIT=120
BROWSER_METADATA_WINDOW_SECONDS=60
BROWSER_SNAPSHOT_LIMIT=30
BROWSER_SNAPSHOT_WINDOW_SECONDS=60
BROWSER_RENDER_LIMIT=10
BROWSER_RENDER_WINDOW_SECONDS=60
BROWSER_SESSION_CREATE_LIMIT=5
BROWSER_SESSION_CREATE_WINDOW_SECONDS=60
BROWSER_SESSION_ACTION_LIMIT=120
BROWSER_SESSION_ACTION_WINDOW_SECONDS=60
BROWSER_RATE_NETWORK_MULTIPLIER=10
BROWSER_MAX_CONCURRENT_OPERATIONS=4
BROWSER_MAX_ACTIVE_SESSIONS=8
BROWSER_MAX_ANONYMOUS_SESSIONS_PER_OWNER=2
BROWSER_MAX_AUTHENTICATED_SESSIONS_PER_OWNER=3
BROWSER_SESSION_IDLE_MINUTES=10
BROWSER_SESSION_ABSOLUTE_MINUTES=30
BROWSER_PUBLIC_CACHE_SECONDS=30
BROWSER_CPUS=2.0
BROWSER_MEM_LIMIT=2g
BROWSER_PIDS_LIMIT=256
BROWSER_SHM_SIZE=512m
BROWSER_TMPFS_SIZE=1g
