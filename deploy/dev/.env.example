COMPOSE_PROJECT_NAME=taskforge-dev
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=taskforge_dev_password
POSTGRES_IMAGE=postgres:18-alpine
JWT_SIGNING_KEY=dev_change_me_please_change_me_please_32_chars
JWT_ISSUER=TaskForge
JWT_AUDIENCE=TaskForge
JWT_EXPIRE_MINUTES=120
# Admin bootstrap is explicit even in dev. Put your test admin emails here.
BOOTSTRAP_FIRST_USER_IS_ADMIN=false
BOOTSTRAP_ADMIN_EMAILS=admin@test.local
MIGRATE_ON_STARTUP=true
ENSURE_CREATED=false
MINIO_ROOT_USER=taskforge
MINIO_ROOT_PASSWORD=taskforge_minio_password
S3_BUCKET=taskforge-files
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
DOMAIN=taskforge.local
CT_DOMAIN=ct.taskforge.local
# Host ports for local dev. 18080 is used by default to avoid conflicts with other dev servers on 8080.
DEV_GATEWAY_HTTP_PORT=18080
DEV_POSTGRES_PORT=5432
DEV_RABBITMQ_PORT=5672
DEV_RABBITMQ_MANAGEMENT_PORT=15672
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001

# Internal service-to-service API key
TASKFORGE_INTERNAL_KEY=dev_internal_key_change_me

# Language runner container limits. Increase only if real tasks need more resources.
RUNNER_MEM_LIMIT=512m
RUNNER_PIDS_LIMIT=128
RUNNER_TMPFS_SIZE=256m

# AI worker provider/internal API settings
TASKFORGE_AGENT_INTERNAL_KEY=dev_internal_agent_key_change_me
TASKFORGE_EXTERNAL_AI_API_KEY=
TASKFORGE_EXTERNAL_AI_MODEL=openai/gpt-4o-mini
# Judge / execution queue
JUDGE_TIMEOUT_SECONDS=45
EXECUTION_QUEUE_MAX_ATTEMPTS=3
EXECUTION_QUEUE_RUNNING_TIMEOUT_MINUTES=5
CODE_ANALYZER_ENABLED=true
CODE_ANALYZER_FAIL_CLOSED=true
CODE_ANALYZER_TIMEOUT_SECONDS=8

